# Fill only after confirming the staging bucket's actual location.
IMAGE_BUCKET=your-staging-bucket
IMAGE_REGION=your-staging-bucket-region
# Choose an explicit staging capacity; production capacity needs quota review.
IMAGE_MAX_INSTANCES=3
IMAGE_SERVICE_ACCOUNT=blog-image-pipeline@book-blog-with-largo.iam.gserviceaccount.com

# Keep true until existing writers are safely retired and cutover is approved.
IMAGE_PROCESSING_PAUSED=true
